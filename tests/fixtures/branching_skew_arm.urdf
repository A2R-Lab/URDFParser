<?xml version="1.0"?>
<!-- Synthetic Y-shaped fixed-base arm exercising NON-CARDINAL (skew) <axis>
     joints on a BRANCHING topology (multiple joints at the SAME BFS level).
     This is the dedicated oracle target for branching-skew aba/minv (joint-1b
     lifted the single-joint-per-BFS-level restriction in _aba.py / _minv.py):

       joint_1 : revolute about skew axis (1,1,1)   base   -> link1   (level 0)
       joint_2 : revolute about skew axis (1,1,0)   link1  -> link2   (level 1)
       joint_3 : prismatic along skew axis (0,1,1)  link1  -> link3   (level 1)
       joint_4 : revolute about skew axis (1,0,1)   link2  -> link4   (level 2)

     joint_2 and joint_3 share parent link1 -> both sit at BFS level 1, so the
     Tier-B dense-S backward/forward emits must loop over multiple joints per
     level (and accumulate pA/IA into the shared parent) rather than assume a
     single serial joint. Non-axis-aligned inertias keep the full 6-vector S
     exercised. Pinocchio supports these unaligned axes (correctness oracle). -->
<robot name="branching_skew_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="-0.03 0.05 0.07" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.035" ixy="0.004" ixz="0.002" iyy="0.045" iyz="0.003" izz="0.028"/>
    </inertial>
  </link>

  <link name="link4">
    <inertial>
      <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.001" izz="0.015"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="1 1 1"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="1 1 0"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link1"/>
    <child link="link3"/>
    <origin xyz="0.10 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 1"/>
    <limit effort="100" velocity="10" lower="-0.5" upper="0.5"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link2"/>
    <child link="link4"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="1 0 1"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
