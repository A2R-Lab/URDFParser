<?xml version="1.0"?>
<!-- Synthetic fixed-base arm exercising a PLANAR joint with a SKEW (non-cardinal)
     plane normal, decomposed at parse time with the minimal-rotation basis
     (R = FromTwoVectors(+Z, n)) into prismatic(a) -> prismatic(b) -> continuous(n)
     through two zero-mass dummy links -- every sub-joint is a Tier-B skew-axis
     1-DOF joint. A trailing revolute joint gives a real moving child past the
     planar block. Validated against a PROGRAMMATIC pinocchio unaligned-composite
     model (pinocchio's URDF loader IGNORES a planar <axis>, so there is no
     native URDF oracle for a skew normal). -->
<robot name="skew_planar_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <joint name="planar_joint" type="planar">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0.1 0.0 0.15" rpy="0 0 0"/>
    <axis xyz="0.36 0.48 0.8"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.0 0.0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
