<?xml version="1.0"?>
<!-- Synthetic fixed-base arm exercising a PLANAR joint (Phase-6 STAGE 3),
     decomposed at parse time into prismatic(X) -> prismatic(Y) -> revolute(Z)
     through two zero-mass dummy links. A trailing revolute joint gives a real
     moving child past the planar block so the mass matrix / RNEA exercise the
     full decomposed chain. The decomposition is validated against pinocchio's
     native JointModelPlanar. -->
<robot name="planar_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <joint name="planar_joint" type="planar">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0.1 0.0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.0 0.0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
