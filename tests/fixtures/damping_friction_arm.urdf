<?xml version="1.0"?>
<!-- Synthetic 2-link fixed-base arm exercising <dynamics damping> and
     <dynamics friction> for Phase-6 STAGE 2 (joint-local viscous + Coulomb
     bias). joint_1 has BOTH damping and friction; joint_2 has damping only.
     Both are cardinal-axis revolute (Tier A) so the bias is the ONLY new
     value-path term. Used as the dedicated correctness oracle target for the
     value-path bias (tau += damping*qd + friction*sign(qd)). -->
<robot name="damping_friction_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.7" friction="0.3"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.4"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>
</robot>
