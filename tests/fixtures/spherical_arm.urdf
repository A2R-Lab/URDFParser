<?xml version="1.0"?>
<!-- Synthetic fixed-base arm exercising the SPHERICAL (ball) joint for Phase-6
     STAGE 4 (the only genuinely-new MANIFOLD joint type: 3-DOF rotation,
     NV=3 / NQ=4 unit quaternion, SO(3) exp retract).

       joint_1: spherical (ball) joint  -> NV=3, NQ=4 (unit quaternion)
       joint_2: revolute about +Z       -> NV=1, NQ=1 (mixed chain, exercises
                                            the NQ!=NV q/v index maps)

     Pinocchio oracle: JointModelSpherical (quaternion variant; NOT the ZYX
     Euler variant). Quaternion convention xyzw (matches pinocchio). Inertias
     carry off-diagonal terms so the mass matrix / RNEA / ABA exercise the full
     6x3 angular motion subspace. -->
<robot name="spherical_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <joint name="joint_1" type="spherical">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
