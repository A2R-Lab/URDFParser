<?xml version="1.0"?>
<!-- Synthetic 2-link fixed-base arm whose SECOND moving link (link2) carries a
     structurally-degenerate <inertial>: zero mass + zero inertia. This mirrors
     rizon4's broken zero-inertia bodies. STRICT parse mode must reject it
     (naming the link); LENIENT (default) mode must preserve the legacy silent
     zeroing. The base (root) link is intentionally massless and must be exempt.
     -->
<robot name="degenerate_inertial_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.06" iyz="0.0" izz="0.04"/>
    </inertial>
  </link>

  <!-- DEGENERATE: zero mass and zero inertia on a real moving body. -->
  <link name="link2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="10"/>
  </joint>
</robot>
