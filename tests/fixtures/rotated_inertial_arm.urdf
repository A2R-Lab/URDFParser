<?xml version="1.0"?>
<!-- Rotated and offset <inertial><origin> frames with full tensors, a fixed joint
     whose massive child carries its own rotated inertial (folded into the parent),
     a prismatic joint, and hyphenated joint names. Oracle: pinocchio. -->
<robot name="rotated_inertial_arm">
  <link name="base_link"/>
  <joint name="shoulder-pan" type="revolute">
    <parent link="base_link"/><child link="upper-arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="10" velocity="2"/>
  </joint>
  <link name="upper-arm">
    <inertial>
      <origin xyz="0.1 0.2 0.3" rpy="1.5707963267948966 0.3 -0.4"/>
      <mass value="2.5"/>
      <inertia ixx="0.03" ixy="0.004" ixz="-0.002" iyy="0.02" iyz="0.003" izz="0.01"/>
    </inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper-arm"/><child link="forearm"/>
    <origin xyz="0 0.2 0" rpy="0.5 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3" upper="3" effort="10" velocity="2"/>
  </joint>
  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 1.5707963267948966 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.011" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.013"/>
    </inertial>
  </link>
  <joint name="wrist-slide" type="prismatic">
    <parent link="forearm"/><child link="wrist"/>
    <origin xyz="0.05 0 0.3" rpy="0 0 0.7"/><axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="10" velocity="1"/>
  </joint>
  <link name="wrist">
    <inertial>
      <origin xyz="0.02 -0.01 0.04" rpy="-1.5707963267948966 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0.0001" ixz="0" iyy="0.003" iyz="-0.0002" izz="0.0015"/>
    </inertial>
  </link>
  <joint name="tool0-flange" type="fixed">
    <parent link="wrist"/><child link="tool-plate"/>
    <origin xyz="0 0 0.08" rpy="0.2 -0.1 0.3"/>
  </joint>
  <link name="tool-plate">
    <inertial>
      <origin xyz="0.01 0.02 0.03" rpy="0.4 1.5707963267948966 -0.2"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0.00005" ixz="-0.00002" iyy="0.0004" iyz="0.00003" izz="0.0003"/>
    </inertial>
  </link>
</robot>
