<?xml version="1.0"?>
<!-- Synthetic 3-link fixed-base arm exercising HELICAL / SCREW joints for
     Phase-6 (helical bundles with the general-axis Tier-B path). A helical
     joint is 1-DOF (NQ=NV=1) coupling rotation about an axis with translation
     along it by `pitch` (meters/radian): S = [axis ; pitch*axis].

       joint_1: helical about Z, pitch 0.05 (cardinal axis, but COUPLED S)
       joint_2: revolute about X (plain 1-DOF, mixes a cardinal joint in)
       joint_3: helical (type="screw") about the skew axis (1,1,1)/sqrt(3),
                pitch -0.03 (skew axis AND coupled -> fully general S)

     Pitch convention (extension, since URDF has no native helical type):
       <axis xyz="..." pitch="P"/>  with translation = P * angle, matching
       pinocchio's JointModelHelical pitch. Inertias carry off-diagonal terms
       so RNEA / CRBA exercise the full coupled motion subspace. -->
<robot name="helical_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.001" izz="0.015"/>
    </inertial>
  </link>

  <joint name="joint_1" type="helical">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1" pitch="0.05"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>

  <joint name="joint_3" type="screw">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="1 1 1" pitch="-0.03"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
