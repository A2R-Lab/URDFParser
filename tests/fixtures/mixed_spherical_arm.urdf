<?xml version="1.0"?>
<!-- Mixed chain exercising the NQ!=NV index maps across a spherical joint:
       joint_1: revolute about +Z    -> NV=1, NQ=1   (before the manifold)
       joint_2: spherical (ball)     -> NV=3, NQ=4   (the manifold mid-chain)
       joint_3: revolute about +X    -> NV=1, NQ=1   (after the manifold)
     Total NV=5, NQ=6. Confirms the q-index vs v-index maps stay correct on
     both sides of the quaternion block. Pinocchio oracle built programmatically
     (JointModelRZ, JointModelSpherical, JointModelRX) since urdfdom cannot
     parse type="spherical". -->
<robot name="mixed_spherical_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.05 0.02 0.10" rpy="0 0 0"/>
      <mass value="1.3"/>
      <inertia ixx="0.05" ixy="0.01" ixz="0.005" iyy="0.06" iyz="0.002" izz="0.04"/>
    </inertial>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0.04 -0.03 0.08" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.04" ixy="0.003" ixz="0.001" iyy="0.05" iyz="0.004" izz="0.03"/>
    </inertial>
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.001" izz="0.015"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>

  <joint name="joint_2" type="spherical">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="10" lower="-3.0" upper="3.0"/>
  </joint>
</robot>
